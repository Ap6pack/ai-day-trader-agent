# ========================================
# AI Day Trader Agent Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control

# ===================
# REQUIRED API KEYS
# ===================
# Get these from the respective service providers

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Financial Data APIs
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here
TWELVE_DATA_API_KEY=your_12data_key_here

# News API for sentiment analysis
NEWS_API_KEY=your_newsapi_key_here

# OpenAI for GPT-powered analysis
OPENAI_API_KEY=your_openai_key_here

# ===================
# API SERVER SECURITY
# ===================
# Generate a secure JWT secret with: openssl rand -hex 32
JWT_SECRET_KEY=your_secure_random_jwt_secret_here

# Environment: development or production
ENVIRONMENT=development

# CORS - comma-separated list of allowed origins
# Development example: http://localhost:3000,http://localhost:8080
# Production example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===================
# DATABASE (Optional)
# ===================
# Defaults to SQLite if not specified
# DATABASE_URL=sqlite:///data/trading.db

# ===================
# TRADING CONFIGURATION (Optional)
# ===================
# Adjust based on your capital and risk tolerance

# Trading capital in dollars
TRADING_CAPITAL=5000.0
MIN_POSITION_PERCENTAGE=0.02              # Minimum 2% of capital per trade
MAX_POSITION_PERCENTAGE=0.10              # Maximum 10% of capital per trade

# Portfolio allocation
MAX_PORTFOLIO_ALLOCATION=0.25             # Max 25% of portfolio in one stock

# ===================
# DIVIDEND STRATEGY (Optional)
# ===================
# Alpaca is used for market candles. Dividend capture is a separate optional subsystem.
# Set false if you want to focus on Alpaca paper stock trading without Alpha Vantage/Twelve Data.
DIVIDEND_STRATEGY_ENABLED=false
# Explicit dividend provider order. Use alpha_vantage only if you want dividend capture enabled.
# Other supported values: twelve_data,yahoo_finance
DIVIDEND_DATA_PROVIDERS=alpha_vantage
MIN_DIVIDEND_YIELD=6.0                    # Minimum annual yield for capture
DIVIDEND_CAPTURE_WINDOW_DAYS=7           # Days before ex-dividend to start looking
DIVIDEND_EXIT_WINDOW_DAYS=5              # Days after ex-dividend to exit

# ===================
# RISK MANAGEMENT (Optional)
# ===================
STOP_LOSS_PCT=3.0                        # Stop loss percentage
POSITION_SIZING_METHOD=fixed             # fixed, volatility, or kelly
MAX_DAILY_TRADES=3                       # Prevent overtrading

# ===================
# TECHNICAL INDICATORS (Optional)
# ===================
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0

# ===================
# SYSTEM SETTINGS (Optional)
# ===================
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR
API_CALLS_PER_MINUTE=5                   # Rate limiting for external APIs
CACHE_EXPIRY_MINUTES=15                  # API response cache duration

# ===================
# API RATE LIMITING (Optional)
# ===================
# Twelve Data API settings
TWELVE_DATA_RATE_LIMIT_WAIT=60           # Seconds to wait when rate limited
TWELVE_DATA_MAX_RETRIES=3                # Max retry attempts
TWELVE_DATA_CALLS_PER_MINUTE=8           # Your plan's limit
TWELVE_DATA_PREMIUM=auto                 # auto (detect), true (premium), false (free)

# Alpha Vantage API settings
ALPHA_VANTAGE_RATE_LIMIT_WAIT=60         # Seconds to wait when rate limited
ALPHA_VANTAGE_MAX_RETRIES=3              # Max retry attempts
ALPHA_VANTAGE_CALLS_PER_MINUTE=5         # Your plan's limit

# Advanced rate limiting
API_BACKOFF_FACTOR=2.0                   # Exponential backoff multiplier
API_MAX_BACKOFF_SECONDS=300              # Maximum wait time (5 minutes)
API_JITTER_ENABLED=true                  # Add randomness to prevent thundering herd

# ===================
# API SERVER (Optional)
# ===================
API_HOST=0.0.0.0                         # Bind to all interfaces
API_PORT=8000                            # API server port
API_RELOAD=false                         # Auto-reload on code changes (dev only)
API_WORKERS=1                            # Number of worker processes
API_LOG_LEVEL=info                       # API server log level

# SSL/TLS for HTTPS (production)
# SSL_KEYFILE=/path/to/privkey.pem
# SSL_CERTFILE=/path/to/fullchain.pem
