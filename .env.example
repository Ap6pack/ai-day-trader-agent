# AI Day Trader configuration. Copy to .env and fill in. Never commit .env.
# Values in .env win over variables exported in your shell.

# ---------------------------------------------------------------------------
# Trading mode and hard limits (enforced by the order guard hook)
# ---------------------------------------------------------------------------
# review: orders are never placed; Claude reviews and journals decisions only.
# live:   orders may be placed after passing the limits below AND your approval.
TRADER_MODE=review

# Largest buy the guard lets through, in dollars. Sells are not capped.
TRADER_MAX_ORDER_USD=500
# Orders that may pass the guard per trading day (US/Eastern).
TRADER_MAX_ORDERS_PER_DAY=3
# An order must match a review_equity_order for the same symbol and side
# made within this many minutes.
TRADER_REVIEW_WINDOW_MINUTES=15
# Optional comma-separated allowlist, e.g. AAPL,MSFT,NVDA. Empty allows any symbol.
TRADER_ALLOWED_SYMBOLS=
# Options and crypto orders are blocked unless enabled.
TRADER_ALLOW_OPTIONS=false
TRADER_ALLOW_CRYPTO=false

# ---------------------------------------------------------------------------
# Sizing guidance (percent of account equity, used by `python -m trader.sizing`)
# ---------------------------------------------------------------------------
MAX_POSITION_PERCENTAGE=0.10
MAX_PORTFOLIO_ALLOCATION=0.25
STOP_LOSS_PCT=3.0

# ---------------------------------------------------------------------------
# News and Jev
# ---------------------------------------------------------------------------
# TypeSafe Jev scores each headline (https://typesafe.ai).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Alpaca news: real-time, ticker-tagged. Paper-account Trading API keys work.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Paper trading host for the news bot and the market clock. The bot refuses to
# place orders against any other host.
# ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# Market data feed for latest prices: iex (free) or sip (paid).
# ALPACA_DATA_FEED=iex

# NewsAPI fallback (free plan delays articles by about a day).
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Candidate scan (`python -m trader.scan`)
# ---------------------------------------------------------------------------
# Symbols always considered, e.g. AAPL,MSFT,NVDA. Alpaca's most-active stocks and
# top movers are added automatically when the Alpaca keys are set.
TRADER_WATCHLIST=
TRADER_SCREENER_TOP=20
TRADER_MIN_PRICE=5
TRADER_SCAN_MAX_SYMBOLS=25
TRADER_SHORTLIST_SIZE=5

# ---------------------------------------------------------------------------
# News bot (`python -m trader.newsbot run`): autonomous, Alpaca paper only
# ---------------------------------------------------------------------------
# off: signals are judged and journaled, no orders. paper: bracket orders on the
# Alpaca paper account with no approval step.
NEWSBOT_EXECUTION=off
# Which stocks the bot may trade:
#   auto  (recommended) today's in-play stocks, refreshed every NEWSBOT_UNIVERSE_REFRESH_MINUTES
#         from TRADER_WATCHLIST plus Alpaca's most-active stocks and top movers above
#         TRADER_MIN_PRICE. Other headlines are skipped before any Jev call.
#   AAPL,MSFT,...  a fixed list.
#   empty          every one- or two-ticker headline in the market (many Jev calls).
NEWSBOT_SYMBOLS=auto
NEWSBOT_UNIVERSE_REFRESH_MINUTES=15
# Jev thresholds for one headline: "about the company" probability, materiality
# (0 to 1) and the bullish (or bearish) probability mass needed for a signal.
NEWSBOT_MIN_RELEVANCE=0.8
NEWSBOT_MIN_MATERIALITY=0.6
NEWSBOT_MIN_PROBABILITY=0.75
NEWSBOT_MAX_HEADLINE_AGE_SECONDS=120
# Headlines tagged with more symbols than this are roundups and are skipped.
NEWSBOT_MAX_SYMBOLS_PER_HEADLINE=2
# Size per trade in dollars; quantity is whole shares, floor(usd / price).
NEWSBOT_ORDER_USD=500
# Bracket exits, percent from the entry price.
NEWSBOT_TAKE_PROFIT_PCT=2.0
NEWSBOT_STOP_LOSS_PCT=1.0
# Orders per US/Eastern trading day, and minutes between orders in one symbol.
NEWSBOT_MAX_TRADES_PER_DAY=5
NEWSBOT_COOLDOWN_MINUTES=30
NEWSBOT_MIN_PRICE=5
# No new entries this close to the market close. Keep it longer than the gap between
# the cron `flatten` and the close, so nothing opens after the flatten and is held
# overnight (bracket legs are day orders and expire at the close).
NEWSBOT_ENTRY_CUTOFF_MINUTES=15
# `run` closes every paper position this many minutes before the close, read from
# Alpaca's clock so early-close days are covered. Must be less than the entry cutoff.
NEWSBOT_FLATTEN_MINUTES=10

# ---------------------------------------------------------------------------
# Autopilot (`python -m trader.autopilot`): Claude's scheduled score/review runs
# ---------------------------------------------------------------------------
# Robinhood MCP server name as shown by /mcp (tools are mcp__<server>__<tool>).
TRADER_ROBINHOOD_SERVER=claude_ai_Robinhood
# Account used for review_equity_order in unattended runs (never for placing orders).
TRADER_ROBINHOOD_ACCOUNT=
# TRADER_CLAUDE_BIN=/path/to/claude

# ---------------------------------------------------------------------------
# Live trading desk (`python -m trader.desk`, http://127.0.0.1:8000/desk)
# ---------------------------------------------------------------------------
# Symbols on the desk's watchlist (defaults to TRADER_WATCHLIST, then a large-cap list).
# DESK_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD
# true = simulated quotes and bars, no API keys needed.
DESK_DEMO_MODE=false
# Required before binding anywhere but 127.0.0.1 (DESK_HOST).
# DESK_TOKEN=
# DESK_HOST=127.0.0.1
# DESK_PORT=8000
# DESK_QUOTE_INTERVAL=2       # seconds between quote polls
# DESK_ACCOUNT_INTERVAL=10    # seconds between Alpaca account polls

# ---------------------------------------------------------------------------
# Analysis (desk ANALYZE, desk autopilot, `python -m trader.analysis`)
# ---------------------------------------------------------------------------
# Bars used for RSI / MACD / moving averages: 1Min, 5Min, 15Min, 1Hour or 1Day.
ANALYSIS_TIMEFRAME=15Min
# Jev's aggregate headline score (-1..1) needed for a sentiment BUY or SELL.
SENTIMENT_THRESHOLD=0.3
# Position size: MIN..MAX_POSITION_PERCENTAGE of capital, scaled by confidence and volatility.
MIN_POSITION_PERCENTAGE=0.02
# Starting cash of the "default" local portfolio (and analysis capital when none is given).
TRADING_CAPITAL=5000
# Dividend capture: BUY when an ex-date is within the window and the yield is high enough.
DIVIDEND_STRATEGY_ENABLED=true
DIVIDEND_CAPTURE_WINDOW_DAYS=7
MIN_DIVIDEND_YIELD=6.0

# ---------------------------------------------------------------------------
# Desk autopilot (started and stopped from the desk's AUTOPILOT tab)
# ---------------------------------------------------------------------------
# Checked before every trade it would make, in record and paper modes alike.
AUTOPILOT_MIN_CONFIDENCE=0.5
AUTOPILOT_MAX_TRADES_PER_DAY=5
AUTOPILOT_COOLDOWN_MINUTES=30
AUTOPILOT_MIN_PRICE=5
# No entries this many minutes before the close.
AUTOPILOT_ENTRY_CUTOFF_MINUTES=15

# ---------------------------------------------------------------------------
# Journal
# ---------------------------------------------------------------------------
# TRADER_JOURNAL_PATH=data/journal.db
