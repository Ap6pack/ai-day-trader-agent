# AI Day Trader configuration. Copy to .env and fill in. Never commit .env.
# Values in .env win over variables exported in your shell.

# ---------------------------------------------------------------------------
# Trading mode and hard limits (enforced by the order guard hook)
# ---------------------------------------------------------------------------
# review: orders are never placed; Claude reviews and journals decisions only.
# live:   orders may be placed after passing the limits below AND your approval.
TRADER_MODE=review

# Largest buy the guard lets through, in dollars. Sells are not capped.
TRADER_MAX_ORDER_USD=500
# Orders that may pass the guard per trading day (US/Eastern).
TRADER_MAX_ORDERS_PER_DAY=3
# An order must match a review_equity_order for the same symbol and side
# made within this many minutes.
TRADER_REVIEW_WINDOW_MINUTES=15
# Optional comma-separated allowlist, e.g. AAPL,MSFT,NVDA. Empty allows any symbol.
TRADER_ALLOWED_SYMBOLS=
# Options and crypto orders are blocked unless enabled.
TRADER_ALLOW_OPTIONS=false
TRADER_ALLOW_CRYPTO=false

# ---------------------------------------------------------------------------
# Sizing guidance (percent of account equity, used by `python -m trader.sizing`)
# ---------------------------------------------------------------------------
MAX_POSITION_PERCENTAGE=0.10
MAX_PORTFOLIO_ALLOCATION=0.25
STOP_LOSS_PCT=3.0

# ---------------------------------------------------------------------------
# News and Jev
# ---------------------------------------------------------------------------
# TypeSafe Jev scores each headline (https://typesafe.ai).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Alpaca news: real-time, ticker-tagged. Paper-account Trading API keys work.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# NewsAPI fallback (free plan delays articles by about a day).
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Journal
# ---------------------------------------------------------------------------
# TRADER_JOURNAL_PATH=data/journal.db
